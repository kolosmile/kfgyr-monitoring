{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "KFGyR Monitoring",
  "id": "kfgyr-monitoring-app",
  "backend": true,
  "executable": "gpx_kfgyr_monitoring",
  "autoEnabled": false,
  "includes": [
    {
      "type": "page",
      "name": "Agentek és gépek",
      "icon": "plug",
      "path": "/a/kfgyr-monitoring-app/agents",
      "addToNav": false,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Dashboard szerkesztő",
      "icon": "sliders-v-alt",
      "path": "/a/kfgyr-monitoring-app/profiles",
      "addToNav": false,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Jelkatalógus",
      "icon": "sitemap",
      "path": "/a/kfgyr-monitoring-app/schemas",
      "addToNav": false,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Adatexport",
      "icon": "download-alt",
      "path": "/a/kfgyr-monitoring-app/export",
      "defaultNav": true,
      "addToNav": true,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Használati útmutató",
      "icon": "book-open",
      "path": "/a/kfgyr-monitoring-app/guide",
      "addToNav": false,
      "role": "Viewer"
    },
    {
      "type": "page",
      "name": "Jogosultságkezelés",
      "icon": "users-alt",
      "path": "/a/kfgyr-monitoring-app/access-management",
      "addToNav": false,
      "role": "Admin"
    }
  ],
  "info": {
    "description": "MTConnect agent management for Ladder99 Relay",
    "author": {
      "name": "KFGyR"
    },
    "keywords": [
      "mtconnect",
      "monitoring",
      "relay"
    ],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "repository",
        "url": "https://github.com/kolosmile/kfgyr-monitoring"
      }
    ],
    "version": "0.4.28",
    "updated": "2026-11-22"
  },
  "dependencies": {
    "grafanaDependency": ">=13.0.2",
    "plugins": []
  }
}
