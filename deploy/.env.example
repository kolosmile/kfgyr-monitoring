# Set secrets in Coolify. Never commit the real .env file.
POSTGRES_PASSWORD=
GRAFANA_DB_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD=
GRAFANA_PORT=3000
KFGYR_ADMIN_ORG_ID=1
KFGYR_AGENT_ALLOWED_HOSTS=demo.mtconnect.org
KFGYR_AGENT_ALLOWED_NETWORKS=192.168.88.0/24,100.64.0.0/10
KFGYR_RELAY_RUNNER_IMAGE=ghcr.io/kolosmile/kfgyr-relay-runner:0.4.3
KFGYR_PLUGIN_INSTALL=kfgyr-monitoring-app@0.4.4@https://github.com/kolosmile/kfgyr-monitoring/releases/download/plugin-v0.4.4/kfgyr-monitoring-app-0.4.4.zip
KFGYR_RUNNER_URL=http://relay:8091
KFGYR_RUNNER_API_TOKEN=
KFGYR_DISCOVERY_NETWORKS=
KFGYR_VIEWER_ORG_NAME=Main Org.
# Shared Docker network when both stacks run on one host
KFGYR_DATA_NETWORK=kfgyr-data
KFGYR_DB_ADDRESS=db:5432
KFGYR_DB_SSLMODE=disable
# For migration, override with the existing named volume names.
# KFGYR_DB_VOLUME=kfgyr-timescaledb-data
# KFGYR_RELAY_VOLUME=kfgyr-relay-config
# KFGYR_GRAFANA_VOLUME=kfgyr-grafana-data
